# Production environment for the self-hosted HR app. Copy to .env.production (git-ignored) and fill in real values;
# never commit real credentials. All of these are server-side only.

# PostgreSQL over TLS, dedicated non-superuser role
DATABASE_URL=

# Session signing key: 64+ random hex characters
KOON_AUTH_SECRET=

# Bootstrap Super Admin sign-in
KOON_LOGIN_EMAIL=
KOON_LOGIN_PASSWORD_HASH=

# HR <-> Tasks bridge origin; must be https:// in production (the bridge answers 503 when it is missing)
TASK_APP_URL=https://tasks.example.com

# Canonical public origin of this HR site (no path), e.g. https://hr.example.com.
# Used for the write-request origin check, the Secure session cookie and page metadata behind a TLS proxy.
# Your proxy must forward the original Host header.
APP_ORIGIN=https://hr.example.com

NODE_ENV=production
