# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
/.dev.vars

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/node_modules_partial/
/.dev-server.pid
/dev-server.*.log
/.postgres-data/
/.postgres-server.log

# local build / dev / QA artifacts
/.codex-build-*/
.codex-dev-*.log
/.site-*.tar.gz
/.site-stage-*/
/qa.err.log
/qa.out.log
*.tsbuildinfo

# scratch and generated QA output (contents kept locally)
/tmp/
/output/

# local runtime logs and tool config
/*.log
/tests/*.log
/.claude/
